# Example env file for Docker (no secrets). Copy to `.env.prod` and `.env.dev` and fill in real values.
# .env.prod - production settings
# .env.dev  - development settings

# Postgres
POSTGRES_USER=botjde_user
POSTGRES_PASSWORD=change_me

# Bot token (do NOT commit real tokens)
BOT_TOKEN=your_bot_token_here

# JDBC URL - change DB name for dev to keep data separate
# e.g. jdbc:postgresql://database:5432/botjde
JDBC_URL=jdbc:postgresql://database:5432/botjde
